{
  "name": "nuvio-anime-addon",
  "version": "1.3.0",
  "description": "Anime catalogues for Nuvio (Stremio addon protocol) \u2014 airing schedule, trending, seasonal and your AniList or MyAnimeList watch list, mapped to TMDB/IMDb so Nuvio's local scrapers can resolve streams.",
  "main": "server.js",
  "type": "commonjs",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "selftest": "node test/selftest.js",
    "build:mapping": "node scripts/build-mapping.js"
  },
  "dependencies": {
    "express": "^4.19.2"
  },
  "keywords": [
    "nuvio",
    "stremio",
    "anime",
    "anilist",
    "addon"
  ],
  "license": "MIT",
  "files": [
    "server.js",
    "src/",
    "public/",
    "data/",
    "scripts/"
  ]
}
